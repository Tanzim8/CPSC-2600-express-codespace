<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pizza</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <h1>Langara Pizza</h1>
        <p class="tagline">Online Order Form</p>
        <a href="/">Home</a>
    </header>

    <h2>Error</h2>

    <div class="errors">
        <% errors.forEach(err => { %>
            <div class="error-item">
            <div class="error-field"><%= err.field %>:</div>
            <div class="error-message"><%= err.message %></div>
            </div>
        <% }) %>
        </div>
</body>
</html>
